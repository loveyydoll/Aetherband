<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RouletteStudio.Desktop.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="960" d:DesignHeight="600"
        Width="960" Height="600"
        WindowStartupLocation="CenterScreen"
        x:Class="RouletteStudio.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="RouletteStudio — Audio Engine Proving Ground"
        Background="#141417">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- TOP TRANSPORT BAR -->
        <Border Grid.Row="0" Background="#1E1E24" BorderBrush="#2D2D36" BorderThickness="0,0,0,1" Padding="16,10">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                <!-- LOGO & BRAND -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBlock Text="🎰" FontSize="24" VerticalAlignment="Center" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="ROULETTESTUDIO" FontWeight="Bold" FontSize="15" LetterSpacing="1.5" Foreground="#F4F4F5" />
                        <TextBlock Text="HARD REAL-TIME AUDIO ENGINE" FontSize="10" FontWeight="SemiBold" Foreground="#71717A" />
                    </StackPanel>
                </StackPanel>

                <!-- TRANSPORT CONTROLS & TIMELINE -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="14" VerticalAlignment="Center">
                    <!-- TIMELINE COUNTER -->
                    <Border Background="#101014" CornerRadius="6" Padding="14,6" BorderBrush="#2A2A34" BorderThickness="1">
                        <TextBlock Text="{Binding PlayheadTimeText}" FontFamily="Consolas, monospace" FontSize="18" FontWeight="Bold" Foreground="#38BDF8" />
                    </Border>

                    <!-- BUTTONS -->
                    <Button Command="{Binding PlayCommand}" 
                            Padding="16,8" CornerRadius="6" FontWeight="SemiBold">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="▶" Foreground="#4ADE80" />
                            <TextBlock Text="Play" Foreground="#F4F4F5" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding PauseCommand}" Padding="16,8" CornerRadius="6" FontWeight="SemiBold">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="⏸" Foreground="#FACC15" />
                            <TextBlock Text="Pause" Foreground="#F4F4F5" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding StopCommand}" Padding="16,8" CornerRadius="6" FontWeight="SemiBold">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="⏹" Foreground="#F87171" />
                            <TextBlock Text="Stop" Foreground="#F4F4F5" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- AUDIO DEVICE SELECTOR -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,10,0">
                    <TextBlock Text="Device:" VerticalAlignment="Center" FontSize="12" Foreground="#A1A1AA" />
                    <ComboBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}" Width="240" CornerRadius="6">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN STAGE: TRACKS & TIMELINE + MASTER STRIP -->
        <Grid Grid.Row="1" ColumnDefinitions="*,260" Margin="16">
            <!-- LEFT: MULTI-TRACK ARRANGER & TIMELINE -->
            <Border Grid.Column="0" Background="#18181E" CornerRadius="8" BorderBrush="#2A2A34" BorderThickness="1" Margin="0,0,14,0" ClipToBounds="True">
                <Grid RowDefinitions="Auto,Auto,*">
                    <!-- ARRANGER HEADER & TOOLBAR -->
                    <Border Grid.Row="0" Background="#141418" BorderBrush="#25252E" BorderThickness="0,0,0,1" Padding="14,10">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <Button Content="+ Add Audio Track" Click="OnAddTrackClicked" 
                                        Background="#2563EB" Foreground="#FFFFFF" FontWeight="SemiBold"
                                        Padding="12,6" CornerRadius="6" />
                                <TextBlock Text="{Binding Tracks.Count, StringFormat={}{0} Tracks}" 
                                           VerticalAlignment="Center" FontSize="12" Foreground="#71717A" />
                            </StackPanel>

                            <!-- TIMELINE TIME RANGE / POSITION -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock Text="Position:" FontSize="11" Foreground="#71717A" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding PlayheadTimeText}" FontFamily="Consolas, monospace" FontSize="12" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center" />
                                <TextBlock Text="/" FontSize="11" Foreground="#52525B" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding DurationTimeText}" FontFamily="Consolas, monospace" FontSize="12" Foreground="#A1A1AA" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- SCRUBBER / TIMELINE RULER BAR -->
                    <Border Grid.Row="1" Background="#101014" Height="26" BorderBrush="#25252E" BorderThickness="0,0,0,1" Padding="12,0">
                        <Grid>
                            <ProgressBar Minimum="0" Maximum="1" Value="{Binding TimelineProgress}" 
                                         Height="4" Background="#1E1E24" Foreground="#38BDF8" 
                                         VerticalAlignment="Center" CornerRadius="2" />
                        </Grid>
                    </Border>

                    <!-- TRACK LIST & TIMELINE LANES -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Spacing="6" Margin="10">
                            <!-- EMPTY STATE WHEN NO TRACKS LOADED -->
                            <Border IsVisible="{Binding !Tracks.Count}" Background="#121216" CornerRadius="8" Padding="32" Margin="0,20" BorderBrush="#22222A" BorderThickness="1" HorizontalAlignment="Center">
                                <StackPanel HorizontalAlignment="Center" Spacing="10">
                                    <TextBlock Text="🎵" FontSize="36" HorizontalAlignment="Center" />
                                    <TextBlock Text="No Audio Tracks Loaded" FontWeight="Bold" FontSize="16" Foreground="#F4F4F5" HorizontalAlignment="Center" />
                                    <TextBlock Text="Click '+ Add Audio Track' to load WAV, FLAC, MP3, OGG, or AAC files." FontSize="12" Foreground="#71717A" HorizontalAlignment="Center" />
                                    <Button Content="Load Audio File" Click="OnAddTrackClicked" HorizontalAlignment="Center" Margin="0,6,0,0" Padding="14,6" CornerRadius="6" />
                                </StackPanel>
                            </Border>

                            <!-- TRACK ITEMS -->
                            <ItemsControl ItemsSource="{Binding Tracks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#141418" CornerRadius="6" BorderBrush="#282832" BorderThickness="1" Margin="0,0,0,6" Padding="10">
                                            <Grid ColumnDefinitions="260,*">
                                                <!-- TRACK HEADER STRIP (CONTROLS) -->
                                                <Grid Grid.Column="0" RowDefinitions="Auto,Auto,Auto" Margin="0,0,12,0">
                                                    <!-- TRACK NAME & REMOVE -->
                                                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                                                        <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="Bold" FontSize="13" Foreground="#F4F4F5" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                        <Button Grid.Column="1" Command="{Binding RemoveCommand}" Content="✕" FontSize="10" Background="Transparent" Foreground="#71717A" Padding="4,2" />
                                                    </Grid>

                                                    <!-- MUTE & PAN CONTROLS -->
                                                    <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,6">
                                                        <ToggleButton Grid.Column="0" IsChecked="{Binding IsMuted}" Content="M" FontWeight="Bold" FontSize="11" Width="26" Height="24" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" CornerRadius="4" />
                                                        <Slider Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding Pan}" Margin="8,0" Height="20" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="2" Text="{Binding PanText}" FontSize="10" FontFamily="Consolas, monospace" Foreground="#A1A1AA" Width="32" TextAlignment="Right" VerticalAlignment="Center" />
                                                    </Grid>

                                                    <!-- VOLUME FADER -->
                                                    <Grid Grid.Row="2" ColumnDefinitions="*,Auto">
                                                        <Slider Grid.Column="0" Minimum="0" Maximum="1.5" Value="{Binding Volume}" Height="20" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="1" Text="{Binding VolumeDbText}" FontSize="10" FontFamily="Consolas, monospace" Foreground="#38BDF8" Width="48" TextAlignment="Right" VerticalAlignment="Center" />
                                                    </Grid>
                                                </Grid>

                                                <!-- TIMELINE WAVEFORM / LANE RECTANGLE -->
                                                <Border Grid.Column="1" Background="#0C0C10" CornerRadius="4" BorderBrush="#202028" BorderThickness="1" ClipToBounds="True">
                                                    <Grid>
                                                        <!-- TRACK WAVEFORM PLACEHOLDER LANE -->
                                                        <Rectangle Fill="#1E293B" Height="40" Margin="4" RadiusX="3" RadiusY="3" HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding Name}" FontSize="11" Foreground="#475569" Margin="12,0" VerticalAlignment="Center" />
                                                    </Grid>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- RIGHT: MASTER STRIP & VU METERS -->
            <Border Grid.Column="1" Background="#1A1A20" CornerRadius="10" BorderBrush="#2A2A34" BorderThickness="1" Padding="20">
                <Grid RowDefinitions="Auto,*,Auto,Auto">
                    <!-- HEADER -->
                    <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,16">
                        <TextBlock Text="MASTER OUT" FontWeight="Bold" FontSize="14" Foreground="#F4F4F5" HorizontalAlignment="Center" LetterSpacing="1" />
                        <TextBlock Text="{Binding VolumeDbText}" FontWeight="Bold" FontSize="20" Foreground="#38BDF8" HorizontalAlignment="Center" Margin="0,4,0,0" />
                    </StackPanel>

                    <!-- METERS & FADER AREA -->
                    <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" HorizontalAlignment="Center" Margin="0,10">
                        <!-- STEREO METERS -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Stretch">
                            <!-- LEFT METER -->
                            <Border Width="16" Background="#101014" CornerRadius="3" BorderBrush="#2A2A34" BorderThickness="1">
                                <ProgressBar Orientation="Vertical" Minimum="0" Maximum="1" Value="{Binding PeakLeft}"
                                             Background="Transparent" Foreground="#4ADE80" />
                            </Border>
                            <!-- RIGHT METER -->
                            <Border Width="16" Background="#101014" CornerRadius="3" BorderBrush="#2A2A34" BorderThickness="1">
                                <ProgressBar Orientation="Vertical" Minimum="0" Maximum="1" Value="{Binding PeakRight}"
                                             Background="Transparent" Foreground="#4ADE80" />
                            </Border>
                        </StackPanel>

                        <!-- DB LABELS -->
                        <UniformGrid Grid.Column="1" Rows="6" Margin="8,0" HorizontalAlignment="Center">
                            <TextBlock Text="+6" FontSize="10" Foreground="#71717A" VerticalAlignment="Top" />
                            <TextBlock Text=" 0" FontSize="10" Foreground="#4ADE80" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock Text="-6" FontSize="10" Foreground="#71717A" VerticalAlignment="Center" />
                            <TextBlock Text="-12" FontSize="10" Foreground="#71717A" VerticalAlignment="Center" />
                            <TextBlock Text="-24" FontSize="10" Foreground="#71717A" VerticalAlignment="Center" />
                            <TextBlock Text="-∞" FontSize="10" Foreground="#71717A" VerticalAlignment="Bottom" />
                        </UniformGrid>

                        <!-- VOLUME FADER -->
                        <Slider Grid.Column="2" Orientation="Vertical" Minimum="0.0" Maximum="1.5" 
                                Value="{Binding MasterVolume}" Height="280" Width="36" />
                    </Grid>

                    <!-- ANTI-ZIPPER BADGE -->
                    <Border Grid.Row="2" Background="#101014" CornerRadius="4" Padding="6,4" HorizontalAlignment="Center" Margin="0,10,0,0">
                        <TextBlock Text="De-Zippered 256-sample Gain Ramp" FontSize="10" Foreground="#A1A1AA" />
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- BOTTOM STATUS BAR -->
        <Border Grid.Row="2" Background="#101014" BorderBrush="#2D2D36" BorderThickness="0,1,0,0" Padding="16,6">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
                    <Ellipse Width="8" Height="8" Fill="#4ADE80" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="#A1A1AA" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="RouletteStudio v0.1.0-alpha • .NET 10 LTS • Rust MSVC" FontSize="11" Foreground="#52525B" />
            </Grid>
        </Border>
    </Grid>
</Window>

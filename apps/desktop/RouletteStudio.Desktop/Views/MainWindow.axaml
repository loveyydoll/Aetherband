<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RouletteStudio.Desktop.ViewModels"
        xmlns:controls="using:RouletteStudio.Desktop.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="720"
        Width="1280" Height="720"
        MinWidth="960" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        x:Class="RouletteStudio.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Aetherband"
        Background="#0B0B0D">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Window.Styles>
        <Style Selector="Button.transport">
            <Setter Property="Background" Value="#1A1A1F" />
            <Setter Property="Foreground" Value="#E4E4E7" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#2A2A32" />
        </Style>
        <Style Selector="Button.transport:pointerover">
            <Setter Property="Background" Value="#25252C" />
        </Style>
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="#2563EB" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.primary:pointerover">
            <Setter Property="Background" Value="#3B82F6" />
        </Style>
        <Style Selector="ToggleButton.mute">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Background" Value="#1A1A1F" />
            <Setter Property="Foreground" Value="#A1A1AA" />
            <Setter Property="BorderBrush" Value="#2A2A32" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="ToggleButton.mute:checked">
            <Setter Property="Background" Value="#B45309" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#D97706" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- TOP BAR: brand + transport + device -->
        <Border Grid.Row="0" Background="#121216" BorderBrush="#1F1F26" BorderThickness="0,0,0,1" Padding="14,8">
            <Grid ColumnDefinitions="Auto,*,Auto">

                <!-- Brand -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Border Width="28" Height="28" CornerRadius="6" Background="#1D4ED8">
                        <TextBlock Text="A" FontWeight="Bold" FontSize="16" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center" Spacing="0">
                        <TextBlock Text="AETHERBAND" FontWeight="Bold" FontSize="13"
                                   LetterSpacing="2" Foreground="#F4F4F5" />
                        <TextBlock Text="Desktop DAW" FontSize="10" Foreground="#71717A" />
                    </StackPanel>
                </StackPanel>

                <!-- Transport -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center"
                            Spacing="10" VerticalAlignment="Center">
                    <Border Background="#0A0A0C" CornerRadius="4" Padding="12,5" BorderBrush="#22222A" BorderThickness="1">
                        <TextBlock Text="{Binding PlayheadTimeText}" FontFamily="Inter, Consolas, monospace"
                                   FontSize="18" FontWeight="Bold" Foreground="#38BDF8" />
                    </Border>

                    <Button Classes="transport" Command="{Binding PlayCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="▶" Foreground="#4ADE80" />
                            <TextBlock Text="Play" />
                        </StackPanel>
                    </Button>
                    <Button Classes="transport" Command="{Binding PauseCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="⏸" Foreground="#FACC15" />
                            <TextBlock Text="Pause" />
                        </StackPanel>
                    </Button>
                    <Button Classes="transport" Command="{Binding StopCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="⏹" Foreground="#F87171" />
                            <TextBlock Text="Stop" />
                        </StackPanel>
                    </Button>

                    <Border Background="#0A0A0C" CornerRadius="4" Padding="10,5" BorderBrush="#22222A" BorderThickness="1">
                        <TextBlock Text="{Binding DurationTimeText}" FontFamily="Inter, Consolas, monospace"
                                   FontSize="13" Foreground="#A1A1AA" />
                    </Border>
                </StackPanel>

                <!-- Device -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="Output" VerticalAlignment="Center" FontSize="11" Foreground="#71717A" />
                    <ComboBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}"
                              Width="220" FontSize="12">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN: arranger + master -->
        <Grid Grid.Row="1" ColumnDefinitions="*,240" Margin="10">

            <!-- ARRANGER -->
            <Border Grid.Column="0" Background="#101014" CornerRadius="6"
                    BorderBrush="#1F1F26" BorderThickness="1" Margin="0,0,10,0" ClipToBounds="True">
                <Grid RowDefinitions="Auto,Auto,*">

                    <!-- Toolbar -->
                    <Border Grid.Row="0" Background="#141418" BorderBrush="#1F1F26" BorderThickness="0,0,0,1" Padding="12,8">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
                                <Button Classes="primary" Content="+ Add Track" Click="OnAddTrackClicked" />
                                <TextBlock Text="{Binding Tracks.Count, StringFormat={}{0} tracks}"
                                           VerticalAlignment="Center" FontSize="12" Foreground="#71717A" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <TextBlock Text="{Binding PlayheadTimeText}" FontFamily="Consolas, monospace"
                                           FontSize="12" FontWeight="Bold" Foreground="#38BDF8" />
                                <TextBlock Text="/" FontSize="11" Foreground="#52525B" />
                                <TextBlock Text="{Binding DurationTimeText}" FontFamily="Consolas, monospace"
                                           FontSize="12" Foreground="#A1A1AA" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Timeline ruler -->
                    <Border Grid.Row="1" Background="#0C0C10" Height="22" BorderBrush="#1F1F26" BorderThickness="0,0,0,1" Padding="10,0">
                        <ProgressBar Minimum="0" Maximum="1" Value="{Binding TimelineProgress}"
                                     Height="3" Background="#1A1A1F" Foreground="#38BDF8"
                                     VerticalAlignment="Center" CornerRadius="1" />
                    </Border>

                    <!-- Tracks -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Spacing="4" Margin="8">

                            <!-- Empty state -->
                            <Border IsVisible="{Binding !Tracks.Count}" Background="#0E0E12" CornerRadius="6"
                                    Padding="40,32" Margin="0,24" BorderBrush="#1F1F26" BorderThickness="1"
                                    HorizontalAlignment="Center">
                                <StackPanel HorizontalAlignment="Center" Spacing="8">
                                    <TextBlock Text="No tracks" FontWeight="Bold" FontSize="15"
                                               Foreground="#E4E4E7" HorizontalAlignment="Center" />
                                    <TextBlock Text="Add WAV, FLAC, MP3, OGG, or AAC to start."
                                               FontSize="12" Foreground="#71717A" HorizontalAlignment="Center" />
                                    <Button Classes="primary" Content="Load audio" Click="OnAddTrackClicked"
                                            HorizontalAlignment="Center" Margin="0,8,0,0" />
                                </StackPanel>
                            </Border>

                            <ItemsControl ItemsSource="{Binding Tracks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#141418" CornerRadius="4" BorderBrush="#22222A"
                                                BorderThickness="1" Margin="0,0,0,2" Padding="8">
                                            <Grid ColumnDefinitions="220,*" MinHeight="64">

                                                <!-- Track header / mixer strip -->
                                                <Grid Grid.Column="0" RowDefinitions="Auto,Auto,Auto" Margin="0,0,10,0">
                                                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                                                        <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="SemiBold"
                                                                   FontSize="12" Foreground="#F4F4F5" TextTrimming="CharacterEllipsis"
                                                                   VerticalAlignment="Center" />
                                                        <Button Grid.Column="1" Command="{Binding RemoveCommand}"
                                                                Content="✕" FontSize="10" Background="Transparent"
                                                                Foreground="#71717A" Padding="4,2" />
                                                    </Grid>

                                                    <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,4">
                                                        <ToggleButton Grid.Column="0" Classes="mute"
                                                                      IsChecked="{Binding IsMuted}" Content="M" />
                                                        <Slider Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding Pan}"
                                                                Margin="8,0" Height="18" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="2" Text="{Binding PanText}" FontSize="10"
                                                                   FontFamily="Consolas, monospace" Foreground="#A1A1AA"
                                                                   Width="36" TextAlignment="Right" VerticalAlignment="Center" />
                                                    </Grid>

                                                    <Grid Grid.Row="2" ColumnDefinitions="*,Auto">
                                                        <Slider Grid.Column="0" Minimum="0" Maximum="1.5" Value="{Binding Volume}"
                                                                Height="18" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="1" Text="{Binding VolumeDbText}" FontSize="10"
                                                                   FontFamily="Consolas, monospace" Foreground="#38BDF8"
                                                                   Width="48" TextAlignment="Right" VerticalAlignment="Center" />
                                                    </Grid>
                                                </Grid>

                                                <!-- Waveform lane -->
                                                <Border Grid.Column="1" Background="#0A0A0C" CornerRadius="3"
                                                        BorderBrush="#1A1A20" BorderThickness="1" ClipToBounds="True"
                                                        MinHeight="56">
                                                    <Grid>
                                                        <controls:WaveformControl Peaks="{Binding Peaks}"
                                                                                  Progress="{Binding Progress}"
                                                                                  WaveformBrush="#38BDF8"
                                                                                  PlayheadBrush="#F8FAFC"
                                                                                  LaneBrush="#0A0A0C" />
                                                        <TextBlock IsVisible="{Binding IsGeneratingPeaks}"
                                                                   Text="Generating waveform…" FontSize="11"
                                                                   Foreground="#52525B" Margin="10,0"
                                                                   VerticalAlignment="Center" />
                                                    </Grid>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- MASTER STRIP -->
            <Border Grid.Column="1" Background="#121216" CornerRadius="6"
                    BorderBrush="#1F1F26" BorderThickness="1" Padding="16">
                <Grid RowDefinitions="Auto,*,Auto">
                    <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,12">
                        <TextBlock Text="MASTER" FontWeight="Bold" FontSize="12"
                                   Foreground="#A1A1AA" HorizontalAlignment="Center" LetterSpacing="1.5" />
                        <TextBlock Text="{Binding VolumeDbText}" FontWeight="Bold" FontSize="20"
                                   Foreground="#38BDF8" HorizontalAlignment="Center" Margin="0,4,0,0" />
                    </StackPanel>

                    <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" HorizontalAlignment="Center">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="5">
                            <Border Width="14" Background="#0A0A0C" CornerRadius="2" BorderBrush="#22222A" BorderThickness="1">
                                <ProgressBar Orientation="Vertical" Minimum="0" Maximum="1" Value="{Binding PeakLeft}"
                                             Background="Transparent" Foreground="#4ADE80" />
                            </Border>
                            <Border Width="14" Background="#0A0A0C" CornerRadius="2" BorderBrush="#22222A" BorderThickness="1">
                                <ProgressBar Orientation="Vertical" Minimum="0" Maximum="1" Value="{Binding PeakRight}"
                                             Background="Transparent" Foreground="#4ADE80" />
                            </Border>
                        </StackPanel>

                        <UniformGrid Grid.Column="1" Rows="6" Margin="8,0">
                            <TextBlock Text="+6" FontSize="9" Foreground="#52525B" />
                            <TextBlock Text="0" FontSize="9" Foreground="#4ADE80" FontWeight="SemiBold" />
                            <TextBlock Text="-6" FontSize="9" Foreground="#52525B" />
                            <TextBlock Text="-12" FontSize="9" Foreground="#52525B" />
                            <TextBlock Text="-24" FontSize="9" Foreground="#52525B" />
                            <TextBlock Text="-∞" FontSize="9" Foreground="#52525B" />
                        </UniformGrid>

                        <Slider Grid.Column="2" Orientation="Vertical" Minimum="0" Maximum="1.5"
                                Value="{Binding MasterVolume}" Height="260" Width="32" />
                    </Grid>

                    <TextBlock Grid.Row="2" Text="256-sample gain ramp" FontSize="10"
                               Foreground="#52525B" HorizontalAlignment="Center" Margin="0,10,0,0" />
                </Grid>
            </Border>
        </Grid>

        <!-- STATUS -->
        <Border Grid.Row="2" Background="#0A0A0C" BorderBrush="#1F1F26" BorderThickness="0,1,0,0" Padding="14,5">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                    <Ellipse Width="7" Height="7" Fill="#4ADE80" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="#A1A1AA" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="Aetherband · .NET 10 · Rust" FontSize="11" Foreground="#3F3F46" />
            </Grid>
        </Border>
    </Grid>
</Window>

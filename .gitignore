# ==============================================================================
# CustomDAW .gitignore (Rust + .NET / C# + Visual Studio + Audio Project Caches)
# ==============================================================================

# --- Rust Build Artifacts ---
/target/
**/*.rs.bk
Cargo.lock.backup

# --- .NET & C# Build Artifacts ---
[Bb]in/
[Oo]bj/
*.user
*.userosscache
*.sln.docstates
.vs/
.vscode/

# --- Native Dynamic Libraries & Symbols (Generated by Rust for C# consumption) ---
# Keep repo clean; binaries are built by build scripts
*.dll
*.dylib
*.so
*.pdb
*.ilk
*.exp
*.lib

# --- Visual Studio & IDE Temp Files ---
*.suo
*.userprefs
*.pidb
*.booproj
*.svclog
*.visualstate

# --- OS Specific Files ---
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini

# --- Audio & Large Media Caches ---
# Don't check in raw gigabyte-sized test recordings or local waveform caches
*.dawproject_cache/
assets/cache/
*.wavecache
